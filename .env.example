# PostgreSQL exposed by docker-compose.yml on the host.
DATABASE_URL=postgres://gomaso:gomaso@localhost:5434/go_maso?sslmode=disable
POSTGRES_PORT=5434

# API and monitoring defaults.
HTTP_ADDRESS=:8080
SHUTDOWN_TIMEOUT=10s
MONITOR_WORKERS=10
RESULT_RETENTION_DAYS=30

# Required when running the API directly. Never reuse these placeholders.
ADMIN_EMAIL=admin@gomaso.local
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_STANDARD_BASE64_FOR_32_RANDOM_BYTES
SESSION_SECURE_COOKIE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
TRUST_PROXY_HEADERS=false
